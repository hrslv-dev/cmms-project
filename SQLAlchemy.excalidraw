    {
      "id": "Bz-L4uSnOcWkCpbIYiC4f",
      "type": "text",
      "x": -994.7426183856123,
      "y": 1536.1323878148783,
      "width": 617.37939453125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b52",
      "roundness": null,
      "seed": 97682090,
      "version": 36,
      "versionNonce": 1343445046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792415303919,
      "created": 1792415290942,
      "link": null,
      "locked": false,
      "text": "SELECT pg_catalog.pg_class.relname\nFROM pg_catalog.pg_class\nJOIN pg_catalog.pg_namespace\n    ON pg_catalog.pg_namespace.oid =\n       pg_catalog.pg_class.relnamespace\nWHERE pg_catalog.pg_class.relkind =\n    ANY (ARRAY[%(param_1)s, %(param_2)s])\nAND pg_catalog.pg_class.relpersistence != %(relpersistence_1)s\nAND pg_catalog.pg_namespace.nspname = %(nspname_1)s",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT pg_catalog.pg_class.relname\nFROM pg_catalog.pg_class\nJOIN pg_catalog.pg_namespace\n    ON pg_catalog.pg_namespace.oid =\n       pg_catalog.pg_class.relnamespace\nWHERE pg_catalog.pg_class.relkind =\n    ANY (ARRAY[%(param_1)s, %(param_2)s])\nAND pg_catalog.pg_class.relpersistence != %(relpersistence_1)s\nAND pg_catalog.pg_namespace.nspname = %(nspname_1)s",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
